    "info": {
      "gregorian": {
        "firstImplemented": "1582 年",
        "history": "由教皇格列高利十三世引入，以纠正儒略历的偏差。闰年跳过世纪年，除非能被 400 整除。在欧洲和美洲逐步采用，现为国际民用标准。",
        "usedIn": [
          "美国",
          "加拿大",
          "墨西哥",
          "巴西",
          "英国",
          "法国",
          "德国",
          "意大利",
          "西班牙",
          "澳大利亚",
          "日本",
          "中国（民用）",
          "印度（民用）",
          "世界大部分地区"
        ]
      },
      "julian": {
        "firstImplemented": "公元前 45 年",
        "history": "由尤利乌斯·凯撒从罗马共和历改革而来。采用简单的闰年规则（每四年一闰），仍是若干东正教会的礼仪历。",
        "usedIn": [
          "俄罗斯（至 1918 年）",
          "东正教会",
          "埃塞俄比亚（有变体）",
          "塞尔维亚",
          "耶路撒冷教区",
          "阿索斯山"
        ]
      },
      "ethiopian": {
        "firstImplemented": "约公元 4 世纪",
        "history": "由十三个 30 天月份加一个短闰日（Pagume）组成的太阳历。与儒略闰年规则相同，比公历晚约七到八年。埃塞俄比亚在民用和宗教生活中与公历并用。",
        "usedIn": [
          "埃塞俄比亚",
          "厄立特里亚东正教社区"
        ]
      },
      "coptic": {
        "firstImplemented": "约公元 3 世纪",
        "history": "科普特正教会的礼仪历，结构与埃塞俄比亚历相同，但从殉道者纪元（Anno Martyrum）起算。新年在公历 9 月 11 日（公历闰年前为 9 月 12 日）。",
        "usedIn": [
          "埃及",
          "全球科普特正教会"
        ]
      },
      "chinese": {
        "firstImplemented": "约公元前 14 世纪（传说）；约公元前 104 年定规",
        "history": "传统农历（农历）以节气锚定阴历月，年份以天干地支（干支）六十甲子命名。每年还有生肖（生肖）。闰月使节日与季节对齐。",
        "usedIn": [
          "中国",
          "台湾",
          "香港",
          "澳门",
          "新加坡",
          "马来西亚",
          "海外华人社区"
        ]
      },
      "soviet": {
        "firstImplemented": "1929 年",
        "history": "在斯大林工业化时期引入，此革命历以五天生产周期取代七天周，并将一年重组为十二个月各 30 天加国家假日。公历仍并行用于日常生活；该实验于 1940 年前放弃。",
        "usedIn": [
          "苏联（1929–1940）"
        ]
      },
      "frc": {
        "firstImplemented": "1793 年",
        "history": "法国大革命期间为十进制计时而创。年以秋分开始；月与周被重命名和重组。拿破仑于 1806 年废除；巴黎公社于 1871 年短暂恢复。",
        "usedIn": [
          "法国（1793–1805）",
          "巴黎公社（1871）"
        ]
      },
      "maya": {
        "firstImplemented": "约公元前 500 年",
        "history": "古典玛雅使用交织周期：260 天的卓尔金历、365 天的哈布历，以及从神话创世纪日起算日期的长纪。本显示采用纪念碑和抄本中常见的长纪记法。",
        "usedIn": [
          "墨西哥",
          "危地马拉",
          "伯利兹",
          "洪都拉斯",
          "萨尔瓦多"
        ]
      },
      "islamic": {
